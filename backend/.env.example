# Copy only if backend/.env does not exist. Never commit keys.
AGENT_ENABLED=1
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to 1 ONLY after verifying AI Studio shows Free and no billing account is linked.
GEMINI_FREE_TIER_CONFIRMED=0
# This demo must contain only fictional input and records.
AGENT_SYNTHETIC_ONLY_CONFIRMED=0
# OpenAI is inactive. Never enable without explicit permission for paid usage.
ALLOW_PAID_OPENAI=0
# Optional: absolute path to a separate synthetic database. Never use nourish.db.
# AGENT_DATABASE_URL=sqlite:////absolute/path/agent-demo.db
